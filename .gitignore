# =============================================================================
# RasnuOS Agent — .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Compiled binaries — local dev builds (root of repo)
# -----------------------------------------------------------------------------

# The main agent binary produced by `go build ./cmd/rasnuos-agent`.
# Anchored to the repo root on purpose: an unanchored `rasnuos-agent` pattern
# would also ignore the cmd/rasnuos-agent/ SOURCE directory.
/rasnuos-agent
/rasnuos-agent-new

# Any platform-specific binary produced locally (not via scripts/build-all.sh)
/rasnuos-agent-*

# Windows executables produced locally
*.exe
*.exe~

# Ad-hoc local build outputs (never commit binaries; releases live on GitHub Releases)
/agent
/agent_test
/agent_test_mac
/rasnucloud-agent
/rasnuone-agent
/test_build
/test_darwin
/bin/

# Runtime audit log written by the agent / tests when the OS log dir is unavailable
audit.jsonl

# Shared libraries
*.dll
*.so
*.dylib

# -----------------------------------------------------------------------------
# Build script output — binaries produced by build-all.sh
# -----------------------------------------------------------------------------

# All compiled release binaries go here; never commit them
/build/
/dist/
/dist-test/

# -----------------------------------------------------------------------------
# Test artifacts
# -----------------------------------------------------------------------------

# Binaries produced by `go test -c`
*.test

# osadapter cross-compilation test binaries (old and new package name)
os_adapter.test*
osadapter.test*

# Coverage reports
coverage.out
coverage.html

# Raw test output captured to files during development
test_out.txt
test_out2.txt
*.test_out.txt

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------

# Agent log file written at runtime
*.log

# -----------------------------------------------------------------------------
# Credentials and environment files
# Never commit tokens, bearer credentials, or environment secrets
# -----------------------------------------------------------------------------

*.env
agent.env
.env.local
.env.*.local
.agent_update_keys/
*.key
*.pem

# -----------------------------------------------------------------------------
# Go toolchain
# -----------------------------------------------------------------------------

# Go workspace files (local multi-module dev only)
go.work
go.work.sum

# Vendor directory (uncomment if you ever vendor dependencies)
# vendor/

# -----------------------------------------------------------------------------
# Editor and OS noise
# -----------------------------------------------------------------------------

# JetBrains IDEs (GoLand, IntelliJ)
.idea/

# VS Code
.vscode/

# macOS Finder metadata
.DS_Store
.AppleDouble
.LSOverride

# Vim swap files
*.swp
*.swo
*~

# Windows thumbnail cache
Thumbs.db
ehthumbs.db
Desktop.ini
